# Copia este archivo a .env y cambia los valores antes de subir a EasyPanel.
# En EasyPanel puedes pegar estas variables en Environment del servicio Compose.

MYSQL_ROOT_PASSWORD=cambia-root-muy-largo
MYSQL_DATABASE=sms
MYSQL_USER=sms
MYSQL_PASSWORD=cambia-password-db

# Token que pondras en la app Android (Settings > Cloud Server > Private Token)
GATEWAY_PRIVATE_TOKEN=cambia-este-token-privado

# Minimo 32 caracteres
JWT_SECRET=cambia-este-jwt-secret-de-32-chars-min

# Dominios HTTPS de tu VPS (EasyPanel genera el SSL)
DASHBOARD_GATEWAY_URL=https://sms.tudominio.com/api/3rdparty/v1
DASHBOARD_WEBHOOK_URL=https://panel.tudominio.com/api/webhooks/callback

# En EasyPanel > Dominios:
# - API: servicio backend, puerto 8080
# - Panel: servicio dashboard, puerto 8081
