# Pegar en EasyPanel > Environment del servicio Compose.
# Dominio: https://chat-sms-gateway.rhfh8t.easypanel.host/

MYSQL_ROOT_PASSWORD=cambia-root-muy-largo
MYSQL_DATABASE=sms
MYSQL_USER=sms
MYSQL_PASSWORD=cambia-password-db

# Token en la app Android (Settings > Cloud Server > Private Token)
GATEWAY_PRIVATE_TOKEN=cambia-este-token-privado

# Minimo 32 caracteres
JWT_SECRET=cambia-este-jwt-secret-de-32-chars-min

DASHBOARD_GATEWAY_URL=https://chat-sms-gateway.rhfh8t.easypanel.host/api/3rdparty/v1
DASHBOARD_WEBHOOK_URL=https://chat-sms-gateway.rhfh8t.easypanel.host/api/webhooks/callback

# EasyPanel > Dominios:
# - API: servicio backend, puerto 8080
#   https://chat-sms-gateway.rhfh8t.easypanel.host/
# - Panel: servicio dashboard, puerto 8081
#   https://chat-sms-dashboard.rhfh8t.easypanel.host/
#
# App Android:
# - API URL: https://chat-sms-gateway.rhfh8t.easypanel.host/api/mobile/v1
# - Private Token: mismo valor que GATEWAY_PRIVATE_TOKEN
